  "22-34": 1,
  "23-1": 10,
  "23-2": 1,
  "23-3": 1,
  "23-4": 1,
  "23-5": 1,
  "23-6": 1,
  "23-7": 1,
  "23-8": 1,
  "23-9": 1,
  "23-10": 1,
  "23-11": 3,
  "23-12": 1,
  "23-13": 6,
  "23-14": 5,
  "23-15": 1,
  "23-16": 1,
  "23-17": 1,
  "23-18": 1,
  "23-19": 1,
  "23-20": 1,
  "23-21": 1,
  "23-22": 1,
  "23-23": 1,
  "23-24": 1,
  "23-25": 1,
  "23-26": 1,
  "23-27": 1,
  "23-28": 1,
  "23-29": 1,
  "23-30": 1,
  "23-31": 1,
  "23-32": 1,
  "23-33": 1,
  "23-34": 1
}
  //pondération : de 0 à 10 
  //0 = chemin de terre/village/chateaux/forteresse
  //1 = plaine/colinnes
  //2 = foret clairsemée
  //3 = foret dense
  //4 = ruines
  //5 = rivière/ruisseau 
  //6 = marais
  //8 = lac
  //9 = montagne
  //10 = montagne escarpée
  //NULL = impassable (eau profonde, falaise, volcan, etc)
  // Special places on the grid
  const places = {
    "2-12": "The fortress of Fdirsholas",
    "2-21": "Ruined Castle",
    "3-23": "The Vale of Denaria",
    "4-14": "Resting Place of Gorlois",
    "4-24": "Mountains of Andor",
    "8-25": "Forest of Ascetir",
    "10-19": "City of Kaamelott", // Start place
    "11-29": "Eatoor",
    "14-26": "Ridge of Ascetir",
    "15-4": "The Iste of the Blessed",
    "15-30": "Engerd",
    "18-33": "Caves",
    "19-32": "The feorre Mountains",
    "20-7": "Labyrinth of Gedref", // End place
    "20-25": "Forest of Balow and caves",
    "22-2": "Odin's Castle",
    "23-13": "Ruined castle",
  };

  // Expose places for other scripts (kingdom UI) to use
  window.places = window.places || places;

  // Initialize the grid
  generateGrid(GRID_ROWS, GRID_COLS);
  applyWeights(gridWeights);

  // Ajout des en-têtes de colonnes
  const colHeaders = document.querySelector('.map-grid__col-headers');
  for (let x = 1; x <= GRID_COLS; x++) {
    const colHeader = document.createElement('div');
    colHeader.className = 'map-grid__col-header';
    colHeader.textContent = x;
    colHeaders.appendChild(colHeader);
  }

  // Ajout des en-têtes de lignes
  const rowHeaders = document.querySelector('.map-grid__row-headers');
  for (let y = 1; y <= GRID_ROWS; y++) {
    const rowHeader = document.createElement('div');
    rowHeader.className = 'map-grid__row-header';
    rowHeader.textContent = y;
    rowHeaders.appendChild(rowHeader);
  }

  // --- New: handle start/end designation from inputs ---
  function restoreCellDisplay(cell) {
    if (!cell) return;
    const id = cell.id;
    // restore dataset.weight from gridWeights or default, but do NOT display it in textContent
    const original = gridWeights[id];
    if (original === undefined || original === null) {
      cell.dataset.weight = '';
    } else {
      cell.dataset.weight = original;
    }
    // keep visual weight hidden
    cell.textContent = '';
    // remove any marker/path classes so the cell returns to its normal appearance
    cell.classList.remove('start', 'end', 'path');
    cell.style.color = ''; 
    cell.style.fontWeight = ''; 
  }

  function markAsStart(cell) {
    if (!cell) return;
    cell.dataset.weight = 0;
    cell.textContent = ''; 
    cell.classList.add('start');

    cell.style.color = '';
    cell.style.fontWeight = '';
  }

  function markAsEnd(cell) {
    if (!cell) return;
    cell.dataset.weight = 0;
    cell.textContent = ''; 
    cell.classList.add('end');
    cell.style.color = '';
    cell.style.fontWeight = '';
  }

  function clearPreviousMarkers() {
    const prevStart = document.querySelector('.map-grid__cell.start');
    const prevEnd = document.querySelector('.map-grid__cell.end');
    if (prevStart) restoreCellDisplay(prevStart);
    if (prevEnd) restoreCellDisplay(prevEnd);
  }

  function applyCoordinates(startY, startX, endY, endX) {
    // validate bounds
    function inBounds(y, x) {
      return y >= 1 && y <= GRID_ROWS && x >= 1 && x <= GRID_COLS;
    }
    if (!inBounds(startY, startX) || !inBounds(endY, endX)) {
      alert('Coordonnées hors limites. X: 1–' + GRID_COLS + ', Y: 1–' + GRID_ROWS);
      return;
    }

    clearPreviousMarkers();

    const startId = startY + '-' + startX;
    const endId = endY + '-' + endX;

    const startCell = document.getElementById(startId);
    const endCell = document.getElementById(endId);


    if (startId === endId) {
      markAsStart(startCell);

      const badge = document.createElement('div');
      badge.textContent = ' / ARRIVÉE';
      badge.style.fontWeight = '700';
      badge.style.color = 'red';
      badge.style.fontSize = '0.7rem';

      const existing = startCell.querySelector('.end-badge');
      if (existing) existing.remove();
      badge.className = 'end-badge';
      startCell.appendChild(badge);
      return;
    }

    markAsStart(startCell);
    markAsEnd(endCell);
  }


  const applyBtn = document.getElementById('apply-coords');
  const resetBtn = document.getElementById('reset-coords');

  // Fonction pour exécuter l'algorithme A*
  function runPathfinding() {
    const sx = parseInt(document.getElementById('start-x').value, 10);
    const sy = parseInt(document.getElementById('start-y').value, 10);
    const ex = parseInt(document.getElementById('end-x').value, 10);
    const ey = parseInt(document.getElementById('end-y').value, 10);

    // Construire la matrice pour AStar
    const gridMatrix = Array.from({ length: GRID_ROWS }, () => Array(GRID_COLS).fill(1));
    for (let y = 1; y <= GRID_ROWS; y++) {
      for (let x = 1; x <= GRID_COLS; x++) {
        const id = y + '-' + x;
        const val = gridWeights[id];
        if (val === undefined || val === null) {
          gridMatrix[y-1][x-1] = val === null ? null : 1;
        } else {
          gridMatrix[y-1][x-1] = val;
        }
      }
    }

    // Placer les marqueurs start/end dans la matrice (votre algo les cherche)
    gridMatrix[sy - 1][sx - 1] = 'start';
    gridMatrix[ey - 1][ex - 1] = 'end';

    // Appeler algo AStar compilé
    if (window.AStar && typeof window.AStar.findPath === 'function') {
      try {
        const result = window.AStar.findPath(gridMatrix);
        
        // Effacer les anciens chemins
        document.querySelectorAll('.map-grid__cell.path').forEach(c => c.classList.remove('path'));
        
        if (result && result.path && result.path.length > 0) {
          // Colorier le chemin trouvé
          for (const [r, c] of result.path) {
            const cellId = (r+1) + '-' + (c+1);
            const cell = document.getElementById(cellId);
            if (cell) {
              cell.classList.add('path');
            }
          }
          
          // Afficher les résultats dans l'interface
          const resultsDiv = document.getElementById('path-results');
          const totalCostSpan = document.getElementById('total-cost');
          const pathLengthSpan = document.getElementById('path-length');
          
          if (resultsDiv && totalCostSpan && pathLengthSpan) {
            totalCostSpan.textContent = result.cost.toFixed(1);
            pathLengthSpan.textContent = result.path.length;
            resultsDiv.style.display = 'block';
          }
        } else {
          // Masquer les résultats si aucun chemin trouvé
          const resultsDiv = document.getElementById('path-results');
          if (resultsDiv) {
            resultsDiv.style.display = 'none';
          }
          alert('Aucun chemin trouvé entre les points sélectionnés');
        }
      } catch (err) {
        console.error('Erreur lors de l\'exécution d\'AStar:', err);
        alert('Erreur dans le calcul du chemin');
      }
    } else {
      console.error('AStar.findPath non disponible - vérifiez que le script est chargé');
      alert('Algorithme AStar non disponible');
    }
  }

  // Exposer runPathfinding globalement pour que le bouton Jouer puisse l'appeler
  window.runPathfinding = runPathfinding;

  if (applyBtn) {
    applyBtn.addEventListener('click', () => {
      const sx = parseInt(document.getElementById('start-x').value, 10);
      const sy = parseInt(document.getElementById('start-y').value, 10);
      const ex = parseInt(document.getElementById('end-x').value, 10);
      const ey = parseInt(document.getElementById('end-y').value, 10);
      
      applyCoordinates(sy, sx, ey, ex);
    });
  }



  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      // Effacer les marqueurs et le chemin
      document.querySelectorAll('.map-grid__cell.start, .map-grid__cell.end, .map-grid__cell.path').forEach(cell => restoreCellDisplay(cell));
      
      // Masquer les résultats
      const resultsDiv = document.getElementById('path-results');
      if (resultsDiv) {
        resultsDiv.style.display = 'none';
      }
    });
  }
</script>



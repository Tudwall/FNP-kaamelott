<script>
  /**
   * Generates a grid of cells with the specified number of rows and columns.
   * Each cell is assigned a unique ID and a default weight.
   * @param {number} rows - Number of rows in the grid.
   * @param {number} cols - Number of columns in the grid.
   */
  function generateGrid(rows, cols) {
    const gridContainer = document.querySelector(".map-grid");
    gridContainer.style.display = "grid";
    gridContainer.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
    gridContainer.style.gridTemplateRows = `repeat(${rows}, 1fr)`;

    for (let y = 1; y <= rows; y++) {
      for (let x = 1; x <= cols; x++) {
        const cellId = `${y}-${x}`;
        const cell = document.createElement("div");
        cell.id = cellId;
        cell.className = "map-grid__cell";
        // Ajout des classes 'start' et 'end' pour les cases spéciales
        if (cellId === "10-19") {
          cell.classList.add("start");
        }
        if (cellId === "21-8") {
          cell.classList.add("end");
        }
        // Ne pas afficher la pondération, juste la stocker
        let weight = gridWeights[cellId];
        cell.textContent = ''; // Masquer la pondération
        cell.dataset.weight = (weight === undefined ? "1" : weight);
        gridContainer.appendChild(cell);
      }
    }
  }

  /**
   * Applies custom weights to cells in the grid.
   * @param {Object} weights - Object mapping cell IDs to their weights.
   */
  function applyWeights(weights) {
    for (const [cellId, weight] of Object.entries(weights)) {
      const cell = document.getElementById(cellId);
      if (cell) {
        cell.dataset.weight = weight;
      }
    }
  }


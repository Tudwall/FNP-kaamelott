<div class="maze-container"></div>

<script>
  class MazeBuilder {
    constructor(width, height) {
      this.width = width;
      this.height = height;
      this.cols = 2 * this.width + 1;
      this.rows = 2 * this.height + 1;
      this.maze = this.initArray([]);
      this.maze.forEach((row, r) => {
        row.forEach((cell, c) => {
          switch (r) {
            case 0:
            case this.rows - 1:
              this.maze[r][c] = ["wall"];
              break;
            default:
              if (r % 2 == 1) {
                if (c == 0 || c == this.cols - 1) {
                  this.maze[r][c] = ["wall"];
                }
              } else if (c % 2 == 0) {
                this.maze[r][c] = ["wall"];
              }
          }
        });
        if (r == 0) {
          let doorPos = this.posToSpace(this.rand(1, this.width));
          this.maze[r][doorPos] = ["door", "exit"];
        }
        if (r == this.rows - 1) {
          let doorPos = this.posToSpace(this.rand(1, this.width));
          this.maze[r][doorPos] = ["door", "entrance"];
        }
      });
      this.partition(1, this.height - 1, 1, this.width - 1);
    }
    initArray(value) {
      return new Array(this.rows)
        .fill()
        .map(() => new Array(this.cols).fill(value));
    }
    rand(min, max) {
      return min + Math.floor(Math.random() * (1 + max - min));
    }
    posToSpace(x) {
      return 2 * (x - 1) + 1;
    }
    posToWall(x) {
      return 2 * x;
    }
    inBounds(r, c) {
      if (
        typeof this.maze[r] == "undefined" ||
        typeof this.maze[r][c] == "undefined"
      ) {
        return false;
      }
      return true;
    }
    shuffle(array) {
      for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
      }
      return array;
    }
    partition(r1, r2, c1, c2) {
      let horiz, vert, x, y, start, end;
      if (r2 < r1 || c2 < c1) {
        return false;
      }
      if (r1 == r2) {
        horiz = r1;
      } else {
        x = r1 + 1;
        y = r2 - 1;
        start = Math.round(x + (y - x) / 4);
        end = Math.round(x + (3 * (y - x)) / 4);
        horiz = this.rand(start, end);
      }
      if (c1 == c2) {
        vert = c1;
      } else {
        x = c1 + 1;
        y = c2 - 1;
        start = Math.round(x + (y - x) / 3);
        end = Math.round(x + (2 * (y - x)) / 3);
        vert = this.rand(start, end);
      }
      for (let i = this.posToWall(r1) - 1; i <= this.posToWall(r2) + 1; i++) {
        for (let j = this.posToWall(c1) - 1; j <= this.posToWall(c2) + 1; j++) {
          if (i == this.posToWall(horiz) || j == this.posToWall(vert)) {
            this.maze[i][j] = ["wall"];
          }
        }
      }
      let gaps = this.shuffle([true, true, true, false]);
      if (gaps[0]) {
        let gapPosition = this.rand(c1, vert);
        this.maze[this.posToWall(horiz)][this.posToSpace(gapPosition)] = [];
      }
      if (gaps[1]) {
        let gapPosition = this.rand(vert + 1, c2 + 1);
        this.maze[this.posToWall(horiz)][this.posToSpace(gapPosition)] = [];
      }
      if (gaps[2]) {
        let gapPosition = this.rand(r1, horiz);
        this.maze[this.posToSpace(gapPosition)][this.posToWall(vert)] = [];
      }
      if (gaps[3]) {
        let gapPosition = this.rand(horiz + 1, r2 + 1);
        this.maze[this.posToSpace(gapPosition)][this.posToWall(vert)] = [];
      }
      this.partition(r1, horiz - 1, c1, vert - 1);
      this.partition(horiz + 1, r2, c1, vert - 1);
      this.partition(r1, horiz - 1, vert + 1, c2);
      this.partition(horiz + 1, r2, vert + 1, c2);
    }
    isGap(...cells) {
      return cells.every((array) => {
        let row, col;
        [row, col] = array;
        if (this.maze[row][col].length > 0) {
          if (!this.maze[row][col].includes("door")) {
            return false;
          }
        }
        return true;
      });
    }
    countSteps(array, r, c, val, stop) {
      if (!this.inBounds(r, c)) {
        return false;
      }
      if (array[r][c] <= val) {
        return false;
      }
      if (!this.isGap([r, c])) {
        return false;
      }
      array[r][c] = val;
      if (this.maze[r][c].includes(stop)) {
        return true;
      }
      this.countSteps(array, r - 1, c, val + 1, stop);
      this.countSteps(array, r, c + 1, val + 1, stop);
      this.countSteps(array, r + 1, c, val + 1, stop);
      this.countSteps(array, r, c - 1, val + 1, stop);
    }
    getTreasureLocation() {
      let fromEntrance = this.initArray();
      let fromExit = this.initArray();
      this.totalSteps = -1;
      for (let j = 1; j < this.cols - 1; j++) {
        if (this.maze[this.rows - 1][j].includes("entrance")) {
          this.countSteps(fromEntrance, this.rows - 1, j, 0, "exit");
        }
        if (this.maze[0][j].includes("exit")) {
          this.countSteps(fromExit, 0, j, 0, "entrance");
        }
      }
      let fc = -1,
        fr = -1;
      this.maze.forEach((row, r) => {
        row.forEach((cell, c) => {
          if (typeof fromEntrance[r][c] == "undefined") {
            return;
          }
          let stepCount = fromEntrance[r][c] + fromExit[r][c];
          if (stepCount > this.totalSteps) {
            fr = r;
            fc = c;
            this.totalSteps = stepCount;
          }
        });
      });
      return [fr, fc];
    }
    placeTreasure() {
      let fr, fc;
      [fr, fc] = this.getTreasureLocation();
      this.maze[fr][fc] = ["treasure"];
    }
    display(className) {
      this.parentDiv = document.querySelector("." + className);
      if (!this.parentDiv) {
        alert(
          'Cannot initialise maze - no element found with class name "' +
            className +
            '"'
        );
        return false;
      }
      while (this.parentDiv.firstChild) {
        this.parentDiv.removeChild(this.parentDiv.firstChild);
      }
      const container = document.createElement("div");
      container.id = "maze";
      container.dataset.steps = this.totalSteps;
      this.maze.forEach((row) => {
        let rowDiv = document.createElement("div");
        row.forEach((cell) => {
          let cellDiv = document.createElement("div");
          if (cell) {
            cellDiv.className = cell.join(" ");
          }
          rowDiv.appendChild(cellDiv);
        });
        container.appendChild(rowDiv);
      });
      this.parentDiv.appendChild(container);
      return true;
    }
  }

  // Utilitaire pour convertir la grille du labyrinthe en matrice pour AStar
  function mazeToMatrix(maze) {
    // mur = null, case libre = 1
    return maze.map(row => row.map(cell => {
      if (!cell || cell.length === 0) return 1;
      if (cell.includes('wall')) return null;
      return 1;
    }));
  }

  function findCell(maze, type) {
    for (let r = 0; r < maze.length; r++) {
      for (let c = 0; c < maze[r].length; c++) {
        if (maze[r][c] && maze[r][c].includes(type)) return [r, c];
      }
    }
    return null;
  }

  function showPathOnMaze(maze, path, className) {
    path.forEach(([r, c]) => {
      if (!maze[r][c] || maze[r][c].includes('wall')) return;
      if (!maze[r][c].includes('entrance') && !maze[r][c].includes('exit') && !maze[r][c].includes('treasure')) {
        maze[r][c].push(className);
      }
    });
  }

  // Génère le labyrinthe et l'affiche sans chemin au départ
  const mazeBuilder = new MazeBuilder(10, 10);
  mazeBuilder.placeTreasure();
  mazeBuilder.display("maze-container");

  // Fonction utilitaire pour calculer et afficher un chemin
  function calculatePath(startType, endType, pathClass) {
    // Nettoie les anciens chemins du DOM
    const existingPaths = document.querySelectorAll('#maze .path1, #maze .path2, #maze .path3');
    existingPaths.forEach(cell => {
      cell.classList.remove('path1', 'path2', 'path3');
    });

    const matrix = mazeBuilder.maze.map(row => row.map(cell => {
      if (!cell || cell.length === 0) return 1;
      if (cell.includes('wall')) return null;
      return 1;
    }));

    const start = findCell(mazeBuilder.maze, startType);
    const end = findCell(mazeBuilder.maze, endType);

    if (!start || !end) {
      console.error(`Impossible de trouver ${startType} ou ${endType}`);
      return false;
    }

    const pathMatrix = matrix.map(row => [...row]);
    pathMatrix[start[0]][start[1]] = 'start';
    pathMatrix[end[0]][end[1]] = 'end';

    if (window.AStar && typeof window.AStar.findPath === 'function') {
      const result = window.AStar.findPath(pathMatrix);
      
      if (result && result.path && result.path.length > 0) {
        result.path.forEach(([r, c]) => {
          const mazeEl = document.getElementById('maze');
          if (mazeEl && mazeEl.children[r] && mazeEl.children[r].children[c]) {
            const cellEl = mazeEl.children[r].children[c];
            if (!cellEl.classList.contains('entrance') && 
                !cellEl.classList.contains('treasure') && 
                !cellEl.classList.contains('exit')) {
              cellEl.classList.add(pathClass);
            }
          }
        });
        console.log(`✅ Chemin ${startType} → ${endType} tracé avec ${result.path.length} étapes`);
        return true;
      } else {
        alert(`Aucun chemin trouvé entre ${startType} et ${endType}`);
        return false;
      }
    } else {
      console.error('❌ AStar non disponible');
      alert('Algorithme AStar non disponible');
      return false;
    }
  }

  // Ajoute les événements sur les boutons
  document.addEventListener('DOMContentLoaded', () => {


    // Nouveaux boutons de contrôle
    const entranceTreasureBtn = document.getElementById('path-entrance-treasure');
    const treasureExitBtn = document.getElementById('path-treasure-exit');
    const entranceExitBtn = document.getElementById('path-entrance-exit');
    const regenerateBtn = document.getElementById('regenerate-maze');
    const clearPathsBtn = document.getElementById('clear-paths');

    if (entranceTreasureBtn) {
      entranceTreasureBtn.addEventListener('click', () => {
        calculatePath('entrance', 'treasure', 'path1');
      });
    }

    if (treasureExitBtn) {
      treasureExitBtn.addEventListener('click', () => {
        calculatePath('treasure', 'exit', 'path2');
      });
    }

    if (entranceExitBtn) {
      entranceExitBtn.addEventListener('click', () => {
        calculatePath('entrance', 'exit', 'path3');
      });
    }

    if (regenerateBtn) {
      regenerateBtn.addEventListener('click', () => {
        // Génère un nouveau labyrinthe
        const newMaze = new MazeBuilder(10, 10);
        newMaze.placeTreasure();
        
        // Remplace l'ancien labyrinthe
        Object.assign(mazeBuilder, newMaze);
        
        // Affiche le nouveau labyrinthe
        mazeBuilder.display("maze-container");
        console.log('🔄 Nouveau labyrinthe généré');
      });
    }

    if (clearPathsBtn) {
      clearPathsBtn.addEventListener('click', () => {
        const existingPaths = document.querySelectorAll('#maze .path1, #maze .path2, #maze .path3');
        existingPaths.forEach(cell => {
          cell.classList.remove('path1', 'path2', 'path3');
        });
        console.log('🧹 Chemins effacés');
      });
    }
  });
</script>
